{
  "id": "customer-service-tools",
  "name": "Customer Service Tools",
  "version": "0.1.0",
  "description": "Narrow business tools for retrieval and CRM-backed customer service workflows.",
  "contracts": {
    "tools": [
      "classify_intent",
      "kb_search",
      "faq_location",
      "faq_services",
      "faq_consultation_plans",
      "faq_payment_methods",
      "customer_lookup",
      "customer_orders",
      "customer_consultas",
      "customer_examenes",
      "ticket_create_draft",
      "check_handoff_state",
      "handoff_human",
      "team_claim_handoff",
      "team_resume_handoff"
    ]
  },
  "uiHints": {
    "internalApiKey": {
      "label": "Internal API key",
      "sensitive": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ragApiUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8081"
      },
      "crmAdapterUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8082"
      },
      "internalApiKey": {
        "type": "string",
        "minLength": 1
      },
      "handoffTeamGroupJid": {
        "type": "string",
        "description": "WhatsApp JID of the 'Gutty Agent' team group (format: 120363...@g.us). Capture by having the team post once in the group and reading the chatId from the gateway log or message journal."
      }
    }
  }
}
