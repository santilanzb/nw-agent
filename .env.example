# Every variable the stack reads, with safe placeholders. Copy to .env and fill in.
# Real secrets live in .env (gitignored) and, for production, in the droplet's .env.
#
# Generate the hex secrets with:  openssl rand -hex 32
# Generate the base64 secrets with:  openssl rand -base64 32

# ── Shared ────────────────────────────────────────────────────────────────────
# Postgres. Inside compose the host is `postgres`; from the host machine it is
# localhost:5432. Alembic reads this too.
DATABASE_URL=postgresql://agent:agent@postgres:5432/company_agent
# Shared secret between agent-core and the two internal services. Required by
# rag-api and crm-adapter at startup — they will not boot without it.
INTERNAL_API_KEY=change-me-hex32

# ── rag-api ───────────────────────────────────────────────────────────────────
# `openai` enables semantic retrieval and the intent classifier.
# `disabled` degrades to lexical-only retrieval, and the classifier always
# returns fallback_llm rather than crashing.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
INTENT_THRESHOLD_EXECUTE=0.80
INTENT_THRESHOLD_CLARIFY=0.55
INTENT_TIEBREAK_MARGIN=0.05

# ── crm-adapter ───────────────────────────────────────────────────────────────
# `mock` for hermetic local work, `zoho` to hit the real API.
CRM_PROVIDER=mock
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DC=com
# true => sandbox.zohoapis.com, false => www.zohoapis.com.
#
# A refresh token is BOUND to one environment. Pointing this at the other one
# yields `DOMAIN_TOKEN_MISMATCH` on every call — which is what a Self Client
# token issued from the production console will do against the sandbox, and it
# is the first thing to check when Zoho returns 400 for everything.
#
# The org's Self Client token is production-bound and there is no populated
# sandbox: the sandbox has no product catalogue at all. Reads are safe, but
# note that a handoff CREATES a Note, so `CRM_PROVIDER=zoho` with this false
# writes to the real CRM. docker-compose.local.yml pins CRM_PROVIDER=mock for
# exactly that reason.
ZOHO_SANDBOX=false
HANDOFF_EXPIRE_HOURS=24

# ── agent-core ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Single composition tier: patient turns are care-class and run on the Anthropic
# synchronous Messages API under BAA.
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
ANTHROPIC_ESCALATION_MODEL=claude-sonnet-5
# Webhook signature verification. agent-core REFUSES TO BOOT if this is empty
# unless ALLOW_UNVERIFIED_WEBHOOKS is explicitly true — an unset key used to
# silently disable verification altogether.
WAHA_HOOK_HMAC_KEY=change-me-hex32
ALLOW_UNVERIFIED_WEBHOOKS=false
WAHA_API_KEY=change-me-hex32
WAHA_DASHBOARD_PASSWORD=change-me
WAHA_BASE_URL=http://waha:3000
# Set after WAHA pairing; the team group where handoffs are announced.
HANDOFF_TEAM_GROUP_JID=
# Ingress durability
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
SWEEPER_INTERVAL_SECONDS=30
SWEEPER_PENDING_GRACE_SECONDS=60
LOG_LEVEL=INFO

# ── Observability (Langfuse v2, being retired in favour of Phoenix) ───────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=change-me-base64-32
LANGFUSE_SALT=change-me-base64-32
LANGFUSE_DATABASE_URL=postgresql://agent:agent@postgres:5432/langfuse

# ── Eval harness only ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=
